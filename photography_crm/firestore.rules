rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated owner: full access to everything
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Public: read a single link document by exact ID
    match /links/{linkId} {
      allow read: if request.auth == null;
    }

    // Public: read photoshoot types and packages (non-sensitive pricing data)
    match /photoshootTypes/{typeId} {
      allow read: if request.auth == null;
    }
    match /packages/{packageId} {
      allow read: if request.auth == null;
    }

    // Public: update only signing fields on a client document
    match /clients/{clientId} {
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['email', 'agreementSigned', 'agreementSignedAt', 'status']);
    }

    // Public: create (never overwrite) the signed copy of an agreement.
    // Doc ID must be an active agreement link belonging to this client.
    match /clients/{clientId}/signedDocuments/{linkId} {
      allow create: if request.auth == null
        && get(/databases/$(database)/documents/links/$(linkId)).data.clientId == clientId
        && get(/databases/$(database)/documents/links/$(linkId)).data.type == 'agreement'
        && get(/databases/$(database)/documents/links/$(linkId)).data.active == true
        && request.resource.data.keys().hasOnly(['type', 'linkId', 'agreement', 'agreementText', 'email', 'signature', 'signedAt'])
        && request.resource.data.linkId == linkId
        && request.resource.data.signedAt == request.time
        && request.resource.data.signature is string
        && request.resource.data.signature.size() < 800000;
    }
  }
}
